{
  "name": "encoding-selector",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Pick the character encoding used for the current editor.",
  "keywords": [
    "charset",
    "utf-8",
    "unicode",
    "conversion",
    "latin"
  ],
  "repository": "https://github.com/lumine-code/encoding-selector",
  "bugs": {
    "url": "https://github.com/lumine-code/encoding-selector/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "engines": {
    "lumine": "^1.0.0"
  },
  "backgroundTips": [
    "You can change the character encoding of the current file with {{ 'encoding-selector:show' | keystroke }}"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "consumedServices": {
    "status-bar": {
      "versions": {
        "^1.0.0": "consumeStatusBar"
      }
    }
  },
  "dependencies": {
    "jschardet": "^3.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.6"
  }
}
